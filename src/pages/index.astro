---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Benefits from '../components/Benefits.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const title = 'IPTV Teste XCIPTV APK: Acesso Grátis e Configuração Rápida';
const description =
  'Obtenha seu iptv teste xciptv apk agora. Baixe o aplicativo, configure o login e valide canais, filmes e séries com acesso imediato e sem compromisso.';
---

<BaseLayout title={title} description={description} canonicalPath="/iptv-teste-xciptv-apk/">
  <Hero />
  <main id="main">
    <Features />
    <Benefits />
    <Testimonials />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
